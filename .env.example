# Copy to .env.local. Without Supabase, /app records locally in this browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use an OpenRouter key, not a direct OpenAI key.
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_SUMMARY_MODEL=z-ai/glm-5.3-flash
# Generate with: openssl rand -hex 32
WORKER_SECRET=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3205
# Optional: paths to system ffmpeg/ffprobe. Bundled binaries are used otherwise.
# FFMPEG_PATH=
# FFPROBE_PATH=
